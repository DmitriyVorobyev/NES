  <attributes>
    <name>Список</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.Вакансия</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.ДатаРегистрации</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.ЕстьФайлы</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.Состояние</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.ЭтапРаботы</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	Кандидаты.Ссылка КАК Ссылка,
	Кандидаты.ПометкаУдаления КАК ПометкаУдаления,
	Кандидаты.Код КАК Код,
	Кандидаты.Наименование КАК Наименование,
	Кандидаты.Вакансия КАК Вакансия,
	Кандидаты.ЛичныеДанные КАК ЛичныеДанныеКандидата,
	Кандидаты.Позиция КАК Позиция,
	Кандидаты.Подразделение КАК Подразделение,
	Кандидаты.Ответственный КАК Ответственный,
	Кандидаты.ДатаРегистрации КАК ДатаРегистрации,
	Кандидаты.ИсточникИнформации КАК ИсточникИнформации,
	Кандидаты.Резюме КАК Резюме,
	ВЫБОР
		КОГДА Кандидаты.Рейтинг &lt;> 0
			ТОГДА Кандидаты.Рейтинг
		ИНАЧЕ ЕСТЬNULL(ОценкаПользователя.Оценка, 0)
	КОНЕЦ КАК Рейтинг,
	Кандидаты.СреднийРейтинг КАК СреднийРейтинг,
	Кандидаты.ОжидаемыйДоход КАК ОжидаемыйДоход,
	&quot;&quot; КАК ОжидаемыйДоходВВалютеПоУмолчанию,
	Кандидаты.Состояние КАК Состояние,
	Кандидаты.ДатаРешения КАК ДатаРешения,
	Кандидаты.КомментарийРешения КАК КомментарийРешения,
	ЕСТЬNULL(ТекущийЭтап.ЭтапРаботы, ЗНАЧЕНИЕ(Справочник.ЭтапыРаботыСКандидатами.ПустаяСсылка)) КАК ЭтапРаботы,
	ТекущийЭтап.Состояние КАК СостояниеЭтапа,
	ТекущийЭтап.ДатаВремя КАК ДатаВремяЭтапа,
	Кандидаты.ПричинаОтклонения КАК ПричинаОтклонения,
	Кандидаты.УточнениеНаименования КАК УточнениеНаименования,
	Кандидаты.АдресРезюме КАК АдресРезюме,
	Кандидаты.Предопределенный КАК Предопределенный,
	Кандидаты.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
	ВЫБОР
		КОГДА ЕСТЬNULL(НаличиеФайлов.ЕстьФайлы, ЛОЖЬ) = ЛОЖЬ
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ЕстьФайлы,
	ЕСТЬNULL(ОценкиКандидатовПоХарактеристикам.Оценка, 0) КАК Оценка,
	0 КАК ОтсутствуетСогласие,
	ВЫБОР
		КОГДА СубъектыСоСкрытымиПДн.Субъект ЕСТЬ NULL
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК ПДнСкрыты,
	ДанныеПоискаФизическихЛиц.АдресаЭлектроннойПочты КАК АдресаЭлектроннойПочты,
	ДанныеПоискаФизическихЛиц.Телефоны КАК Телефоны,
	0 КАК Метка1,
	0 КАК Метка2,
	0 КАК Метка3,
	Кандидаты.ЛичныеДанные.ДополнительныеРеквизиты.(
		Свойство) КАК ДополнительныеРеквизиты
ИЗ
	Справочник.Кандидаты КАК Кандидаты
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТекущиеЭтапыРаботыСКандидатами КАК ТекущийЭтап
		ПО Кандидаты.Ссылка = ТекущийЭтап.Кандидат
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаличиеФайлов КАК НаличиеФайлов
		ПО Кандидаты.Ссылка = НаличиеФайлов.ОбъектСФайлами
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Кандидаты.Оценки КАК ОценкаПользователя
		ПО (ОценкаПользователя.Ссылка = Кандидаты.Ссылка)
		И (ОценкаПользователя.Пользователь = &amp;Пользователь)
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОценкиКандидатовПоХарактеристикам КАК ОценкиКандидатовПоХарактеристикам
		ПО Кандидаты.Ссылка = ОценкиКандидатовПоХарактеристикам.Кандидат
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СубъектыДляСкрытияПерсональныхДанных КАК СубъектыСоСкрытымиПДн
		ПО Кандидаты.ЛичныеДанные = СубъектыСоСкрытымиПДн.Субъект
		И (СубъектыСоСкрытымиПДн.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСубъектовДляСкрытия.СкрытиеВыполнено))
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеПоискаФизическихЛиц КАК ДанныеПоискаФизическихЛиц
		ПО Кандидаты.ЛичныеДанные = ДанныеПоискаФизическихЛиц.ФизическоеЛицо
ГДЕ
	(((СубъектыСоСкрытымиПДн.Субъект ЕСТЬ NULL
	ИЛИ &amp;ПоказыватьСоСкрытымиПДн)
	И (ТекущийЭтап.ЭтапРаботы ЕСТЬ NULL
	ИЛИ ТекущийЭтап.ЭтапРаботы &lt;> ЗНАЧЕНИЕ(Перечисление.ЭтапыРаботыСКандидатами.РассмотрениеОтклика))))</queryText>
      <mainTable>Catalog.Кандидаты</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
