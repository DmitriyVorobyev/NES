    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	СредстваИндивидуальнойЗащиты.Ссылка КАК Ссылка,
	СредстваИндивидуальнойЗащиты.ПометкаУдаления КАК ПометкаУдаления,
	СредстваИндивидуальнойЗащиты.Родитель КАК Родитель,
	СредстваИндивидуальнойЗащиты.ЭтоГруппа КАК ЭтоГруппа,
	СредстваИндивидуальнойЗащиты.Наименование КАК Наименование,
	СредстваИндивидуальнойЗащиты.ТипНоменклатуры КАК ТипНоменклатуры,
	СредстваИндивидуальнойЗащиты.КоличествоПоУмолчанию КАК КоличествоПоУмолчанию,
	СредстваИндивидуальнойЗащиты.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	СредстваИндивидуальнойЗащиты.КратностьВыдачи КАК КратностьВыдачи,
	СредстваИндивидуальнойЗащиты.ПериодичностьВыдачи КАК ПериодичностьВыдачи,
	СредстваИндивидуальнойЗащиты.ЕдиницаПериодичностиВыдачи КАК ЕдиницаПериодичностиВыдачи,
	СредстваИндивидуальнойЗащиты.ПредставлениеПериодичностиВыдачи КАК ПредставлениеПериодичностиВыдачи,
	СредстваИндивидуальнойЗащиты.НаименованиеПолное КАК НаименованиеПолное,
	СредстваИндивидуальнойЗащиты.ВидНоменклатуры КАК ВидНоменклатуры,
	СредстваИндивидуальнойЗащиты.ИспользованиеХарактеристик КАК ИспользованиеХарактеристик,
	СредстваИндивидуальнойЗащиты.СпособВыдачи КАК СпособВыдачи,
	СредстваИндивидуальнойЗащиты.НоменклатураПоУмолчанию КАК НоменклатураПоУмолчанию,
	СредстваИндивидуальнойЗащиты.ВладелецХарактеристик КАК ВладелецХарактеристик,
	СредстваИндивидуальнойЗащиты.ДополнительныеРеквизиты.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		Свойство КАК Свойство,
		Значение КАК Значение,
		ТекстоваяСтрока КАК ТекстоваяСтрока
	) КАК ДополнительныеРеквизиты,
	СредстваИндивидуальнойЗащиты.Предопределенный КАК Предопределенный,
	СредстваИндивидуальнойЗащиты.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
	ВЫБОР
		КОГДА ИСТИНА В
				(ВЫБРАТЬ ПЕРВЫЕ 1
					ИСТИНА
				ИЗ
					РегистрСведений.СИЗРабочегоМеста КАК СИЗРабочегоМеста
				ГДЕ
					СИЗРабочегоМеста.СИЗ = СредстваИндивидуальнойЗащиты.Ссылка
					И СИЗРабочегоМеста.РабочееМесто ССЫЛКА Справочник.РабочиеМестаОхраныТруда
					И СИЗРабочегоМеста.РабочееМесто.Владелец = &amp;Организация
					И ВЫБОР
						КОГДА &amp;Подразделение = &amp;ПустоеПодразделение
							ТОГДА ИСТИНА
						ИНАЧЕ СИЗРабочегоМеста.РабочееМесто.Подразделение В ИЕРАРХИИ (&amp;Подразделение)
					КОНЕЦ)
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ЕстьВНормахВыдачи,
	НЕОПРЕДЕЛЕНО КАК ДополнительныеДанные,
	0 КАК КоличествоРабочихМест,
	0 КАК КоличествоСотрудников
ИЗ
	Справочник.СредстваИндивидуальнойЗащиты КАК СредстваИндивидуальнойЗащиты</queryText>
      <mainTable>Catalog.СредстваИндивидуальнойЗащиты</mainTable>
