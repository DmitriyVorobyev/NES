  <attributes>
    <name>СтраховыеКомпании</name>
    <title>
      <key>ru</key>
      <value>Страховые компании</value>
    </title>
    <id>4</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СтраховыеКомпании.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	СправочникКонтрагенты.Ссылка,
	СправочникКонтрагенты.ПометкаУдаления,
	СправочникКонтрагенты.Наименование,
	СправочникКонтрагенты.НаименованиеПолное,
	СправочникКонтрагенты.ЮридическоеФизическоеЛицо,
	СправочникКонтрагенты.ИНН,
	СправочникКонтрагенты.КПП,
	СправочникКонтрагенты.КодПоОКПО,
	СправочникКонтрагенты.Предопределенный,
	СправочникКонтрагенты.ИмяПредопределенныхДанных,
	ВЫБОР
		КОГДА ИСТИНА В
			(ВЫБРАТЬ ПЕРВЫЕ 1
				ИСТИНА
			ИЗ
				Справочник.ДоговорыСтрахования КАК ДоговорыСтрахования
			ГДЕ
				ДоговорыСтрахования.Владелец = СправочникКонтрагенты.Ссылка
				И ВЫБОР
					КОГДА &amp;ПоказыватьЗакрытыеДоговоры
						ТОГДА ИСТИНА
					ИНАЧЕ
					НЕ (ДоговорыСтрахования.ДоговорЗакрыт
					ИЛИ ДоговорыСтрахования.ПометкаУдаления)
				КОНЕЦ
				И ВЫБОР
					КОГДА &amp;ЕстьОтборПоОрганизации
						ТОГДА ДоговорыСтрахования.Организация = &amp;Организация
					ИНАЧЕ ИСТИНА
				КОНЕЦ)
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ЕстьДоговоры
ИЗ
	Справочник.Контрагенты КАК СправочникКонтрагенты</queryText>
      <mainTable>Catalog.Контрагенты</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
