        <key>ru</key>
        <value>Сотрудники, оформленные в отпуск по уходу за ребенком, будут включаться в список сотрудников к откреплению от программ страхования автоматически.</value>
      </toolTip>
      <toolTipRepresentation>ShowBottom</toolTipRepresentation>
