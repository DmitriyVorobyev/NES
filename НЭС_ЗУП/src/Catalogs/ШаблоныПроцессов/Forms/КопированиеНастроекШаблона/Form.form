  <attributes>
    <name>СписокДоступныхШаблонов</name>
    <title>
      <key>ru</key>
      <value>Список доступных шаблонов</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокДоступныхШаблонов.ИдентификаторЭтапа</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокДоступныхШаблонов.Шаблон</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокДоступныхШаблонов.Этап</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	УправлениеЭлементамиФормы.Ссылка КАК Ссылка,
	УправлениеЭлементамиФормы.ИдентификаторЭтапа КАК ИдентификаторЭтапа
ПОМЕСТИТЬ ВТ_СписокДоступныхШаблонов
ИЗ
	Справочник.ШаблоныПроцессов.УправлениеЭлементамиФормы КАК УправлениеЭлементамиФормы
ГДЕ
	УправлениеЭлементамиФормы.Ссылка.ИдентификаторДокумента = &amp;ИдентификаторДокумента
	И Не (УправлениеЭлементамиФормы.ИдентификаторЭтапа = &amp;ИдентификаторТекущегоЭтапа И УправлениеЭлементамиФормы.Ссылка = &amp;ТекущийШаблон) 

СГРУППИРОВАТЬ ПО
	УправлениеЭлементамиФормы.Ссылка,
	УправлениеЭлементамиФормы.ИдентификаторЭтапа
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_СписокДоступныхШаблонов.Ссылка КАК Шаблон,
	ШаблоныПроцессовЭтапы.Этап КАК Этап,
	ШаблоныПроцессовЭтапы.ИдентификаторЭтапа КАК ИдентификаторЭтапа,
	ШаблоныПроцессовЭтапы.НомерСтроки КАК НомерСтрокиЭтапа
ИЗ
	ВТ_СписокДоступныхШаблонов КАК ВТ_СписокДоступныхШаблонов
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШаблоныПроцессов.Этапы КАК ШаблоныПроцессовЭтапы
		ПО ВТ_СписокДоступныхШаблонов.Ссылка = ШаблоныПроцессовЭтапы.Ссылка
			И ВТ_СписокДоступныхШаблонов.ИдентификаторЭтапа = ШаблоныПроцессовЭтапы.ИдентификаторЭтапа</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Этап</dataPath>
        <field>Этап</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ИдентификаторЭтапа</dataPath>
        <field>ИдентификаторЭтапа</field>
        <useRestriction>
          <condition>true</condition>
          <group>true</group>
          <order>true</order>
        </useRestriction>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>НомерСтрокиЭтапа</dataPath>
        <field>НомерСтрокиЭтапа</field>
        <title>
          <localValue>
            <content>
              <key>ru</key>
              <value>Номер строки этапа</value>
            </content>
          </localValue>
        </title>
        <useRestriction>
          <field>true</field>
          <condition>true</condition>
          <group>true</group>
        </useRestriction>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Шаблон</dataPath>
        <field>Шаблон</field>
        <title>
          <localValue>
            <content>
              <key>ru</key>
              <value>Шаблон</value>
            </content>
          </localValue>
        </title>
      </fields>
      <parameters>
        <name>ИдентификаторДокумента</name>
        <title>
          <localValue>
            <content>
              <key>ru</key>
              <value>Идентификатор документа</value>
            </content>
          </localValue>
        </title>
        <valueType>
          <types>CatalogRef.ИдентификаторыОбъектовМетаданных</types>
        </valueType>
        <values xsi:type="core:UndefinedValue"/>
        <useRestriction>true</useRestriction>
      </parameters>
      <parameters>
        <name>ТекущийШаблон</name>
        <title>
          <localValue>
            <content>
              <key>ru</key>
              <value>Текущий шаблон</value>
            </content>
          </localValue>
        </title>
        <valueType>
          <types>CatalogRef.ШаблоныПроцессов</types>
        </valueType>
        <values xsi:type="core:UndefinedValue"/>
        <useRestriction>true</useRestriction>
      </parameters>
      <parameters>
        <name>ИдентификаторТекущегоЭтапа</name>
        <title>
          <localValue>
            <content>
              <key>ru</key>
              <value>Идентификатор текущего этапа</value>
            </content>
          </localValue>
        </title>
        <valueType>
          <types>UUID</types>
        </valueType>
        <values xsi:type="core:UuidValue" value="00000000-0000-0000-0000-000000000000"/>
        <useRestriction>true</useRestriction>
      </parameters>
    </extInfo>
