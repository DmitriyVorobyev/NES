    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ОпросыПоКомпетенциям.Ссылка КАК Ссылка,
	СУММА(ВЫБОР 
		КОГДА ОпросыПоКомпетенциям.НазначениеОпроса = ЗНАЧЕНИЕ(Документ.НазначениеОпросов.ПустаяССылка)
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ) КАК ПустыхНазначенийОпросов,
	СУММА(1) КАК Оцениваемые
ПОМЕСТИТЬ ВТНеНачатые
ИЗ
	Справочник.ОпросыПоКомпетенциям.Оцениваемые КАК ОпросыПоКомпетенциям
СГРУППИРОВАТЬ ПО
ОпросыПоКомпетенциям.Ссылка
;
ВЫБРАТЬ
	СправочникОпросыПоКомпетенциям.Ссылка,
	ЕСТЬNULL(СправочникОпросыПоКомпетенциям.ДатаОкончания &lt; &amp;ДатаАктуальности, ЛОЖЬ) КАК МероприятиеЗавершено,
	НЕ (ЕСТЬNULL(НеНачатые.ПустыхНазначенийОпросов, 0) = ЕСТЬNULL(НеНачатые.Оцениваемые, 0)) КАК АнкетированиеНачато,
	СправочникОпросыПоКомпетенциям.ПометкаУдаления,
	СправочникОпросыПоКомпетенциям.Родитель,
	СправочникОпросыПоКомпетенциям.ЭтоГруппа,
	СправочникОпросыПоКомпетенциям.Наименование,
	СправочникОпросыПоКомпетенциям.Подразделение,
	СправочникОпросыПоКомпетенциям.ШаблонАнкеты,
	СправочникОпросыПоКомпетенциям.ПрофильДолжности,
	СправочникОпросыПоКомпетенциям.ДатаНачала,
	СправочникОпросыПоКомпетенциям.ДатаОкончания,
	СправочникОпросыПоКомпетенциям.Ответственный,
	СправочникОпросыПоКомпетенциям.Комментарий,
	СправочникОпросыПоКомпетенциям.СпособЗаполненияЭкспертов,
	СправочникОпросыПоКомпетенциям.ВидКонтактнойИнформацииОценивающиеЭксперты,
	СправочникОпросыПоКомпетенциям.ИспользоватьОткрытыеВопросы,
	СправочникОпросыПоКомпетенциям.ФормулировкаРазделаОткрытыхВопросов,
	СправочникОпросыПоКомпетенциям.Характеристики,
	СправочникОпросыПоКомпетенциям.Оцениваемые,
	СправочникОпросыПоКомпетенциям.ОценивающиеЭкспертыЕдиныйНабор,
	СправочникОпросыПоКомпетенциям.ОценивающиеЭксперты,
	СправочникОпросыПоКомпетенциям.ОткрытыеВопросы,
	СправочникОпросыПоКомпетенциям.ДополнительныеРеквизиты,
	СправочникОпросыПоКомпетенциям.Предопределенный,
	СправочникОпросыПоКомпетенциям.ИмяПредопределенныхДанных
ИЗ
	Справочник.ОпросыПоКомпетенциям КАК СправочникОпросыПоКомпетенциям
		ЛЕВОЕ СОЕДИНЕНИЕ ВТНеНачатые КАК НеНачатые
		ПО (НеНачатые.Ссылка = СправочникОпросыПоКомпетенциям.Ссылка)
	</queryText>
      <mainTable>Catalog.ОпросыПоКомпетенциям</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Ссылка</dataPath>
        <field>Ссылка</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ДатаНачала</dataPath>
        <field>ДатаНачала</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaNestedDataSet">
        <dataPath>ДополнительныеРеквизиты</dataPath>
        <field>ДополнительныеРеквизиты</field>
      </fields>
