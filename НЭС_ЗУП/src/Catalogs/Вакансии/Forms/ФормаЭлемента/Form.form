  </attributes>
  <attributes>
    <name>СоответствуетПрофилюДолжностиЧисло</name>
    <title>
      <key>ru</key>
      <value>Соответствует профилю должности число</value>
    </title>
    <id>3</id>
    <valueType>
      <types>Number</types>
      <numberQualifiers>
        <precision>1</precision>
        <nonNegative>true</nonNegative>
      </numberQualifiers>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <savedData>true</savedData>
  </attributes>
  <attributes>
    <name>СостоянияВакансийНаборЗаписей</name>
    <id>4</id>
    <valueType>
      <types>InformationRegisterRecordSet.СостоянияВакансий</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
  </attributes>
  <attributes>
    <name>ОткликиКандидатов</name>
    <title>
      <key>ru</key>
      <value>Отклики кандидатов</value>
    </title>
    <id>5</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ОткликиКандидатов.НомерОтклика</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ОткликиКандидатов.Рассмотрено</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ОткликиКандидатов.Вакансия</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ОткликиКандидатов.Рассмотрен</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ОткликиКандидатов.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	Кандидаты.Вакансия КАК Вакансия,
	Кандидаты.ИсточникИнформации КАК Источник,
	Кандидаты.Ссылка КАК Кандидат,
	Кандидаты.ЛичныеДанные КАК ЛичныеДанные,
	Кандидаты.Состояние КАК Состояние,
	Кандидаты.ДатаРегистрации КАК ДатаОтклика,
	ВЫБОР
		КОГДА ЛичныеДанныеКандидатов.ДатаРождения = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА 0
		КОГДА ЛичныеДанныеКандидатов.ДатаРождения >= &amp;ТекущаяДата
			ТОГДА 0
		ИНАЧЕ РАЗНОСТЬДАТ(ЛичныеДанныеКандидатов.ДатаРождения, &amp;ТекущаяДата, ГОД) + ВЫБОР
				КОГДА МЕСЯЦ(ЛичныеДанныеКандидатов.ДатаРождения) > МЕСЯЦ(&amp;ТекущаяДата)
					ТОГДА -1
				КОГДА МЕСЯЦ(ЛичныеДанныеКандидатов.ДатаРождения) = МЕСЯЦ(&amp;ТекущаяДата)
						И ДЕНЬ(ЛичныеДанныеКандидатов.ДатаРождения) > ДЕНЬ(&amp;ТекущаяДата)
					ТОГДА -1
				ИНАЧЕ 0
			КОНЕЦ
	КОНЕЦ КАК Возраст,
	Кандидаты.СопроводительноеПисьмо КАК СопроводительноеПисьмо,
	НЕ(РаботаСКандидатамиСрезПоследних.СостояниеЭтапа = ЗНАЧЕНИЕ(Перечисление.СостоянияЭтаповРаботыСКандидатами.Запланирован)
			И Кандидаты.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСогласования.Рассматривается)) КАК Рассмотрен,
	ВЫБОР
		КОГДА ЛичныеДанныеКандидатов.Пол = ЗНАЧЕНИЕ(Перечисление.ПолФизическогоЛица.Мужской)
			ТОГДА &amp;Мужчина
		КОГДА ЛичныеДанныеКандидатов.Пол = ЗНАЧЕНИЕ(Перечисление.ПолФизическогоЛица.Мужской)
			ТОГДА &amp;Женщина
		ИНАЧЕ &amp;НеУказан
	КОНЕЦ КАК Пол,
	Кандидаты.ОжидаемыйДоход КАК ОжидаемыйДоход,
	&quot;&quot; КАК ОжидаемыйДоходВВалютеПоУмолчанию,
	Кандидаты.ВалютаДохода КАК ВалютаДохода
ПОМЕСТИТЬ ВТДанныеКандидатов
ИЗ
	РегистрСведений.РаботаСКандидатами.СрезПоследних(, ЭтапРаботы = ЗНАЧЕНИЕ(Перечисление.ЭтапыРаботыСКандидатами.РассмотрениеОтклика)) КАК РаботаСКандидатамиСрезПоследних
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Кандидаты КАК Кандидаты
			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЛичныеДанныеКандидатов КАК ЛичныеДанныеКандидатов
			ПО Кандидаты.ЛичныеДанные = ЛичныеДанныеКандидатов.Ссылка
		ПО РаботаСКандидатамиСрезПоследних.Кандидат = Кандидаты.Ссылка
ГДЕ
	НЕ Кандидаты.ПометкаУдаления

ИНДЕКСИРОВАТЬ ПО
	Кандидат,
	ЛичныеДанные
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТДанныеКандидатов.ЛичныеДанные КАК ЛичныеДанные,
	МАКСИМУМ(ЕСТЬNULL(КИАдрес.Представление, &quot;&quot;)) КАК Регион,
	МАКСИМУМ(ЕСТЬNULL(КИТелефон.Представление, &quot;&quot;)) КАК Телефон,
	МАКСИМУМ(ЕСТЬNULL(КИEmail.Представление, &quot;&quot;)) КАК Email
ПОМЕСТИТЬ ВТКонтактнаяИнформация
ИЗ
	ВТДанныеКандидатов КАК ВТДанныеКандидатов
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЛичныеДанныеКандидатов.КонтактнаяИнформация КАК КИАдрес
		ПО ВТДанныеКандидатов.ЛичныеДанные = КИАдрес.Ссылка
			И (КИАдрес.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресЛичныеДанныеКандидатов))
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЛичныеДанныеКандидатов.КонтактнаяИнформация КАК КИТелефон
		ПО ВТДанныеКандидатов.ЛичныеДанные = КИТелефон.Ссылка
			И (КИТелефон.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонЛичныеДанныеКандидатов))
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЛичныеДанныеКандидатов.КонтактнаяИнформация КАК КИEmail
		ПО ВТДанныеКандидатов.ЛичныеДанные = КИEmail.Ссылка
			И (КИEmail.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EMailЛичныеДанныеКандидатов))

СГРУППИРОВАТЬ ПО
	ВТДанныеКандидатов.ЛичныеДанные
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	ПоследнееМестоРаботы.Ссылка КАК Ссылка,
	ЛичныеДанныеКандидатовОпытРаботы.Компания КАК Компания,
	ЛичныеДанныеКандидатовОпытРаботы.Должность КАК Должность,
	ЛичныеДанныеКандидатовОпытРаботы.ДатаНачала КАК ДатаНачала,
	ЛичныеДанныеКандидатовОпытРаботы.ДатаОкончания КАК ДатаОкончания
ПОМЕСТИТЬ ВТПоследнееМестоРаботы
ИЗ
	(ВЫБРАТЬ
		ЛичныеДанныеКандидатовОпытРаботы.Ссылка КАК Ссылка,
		МАКСИМУМ(ЛичныеДанныеКандидатовОпытРаботы.НомерСтроки) КАК НомерСтроки
	ИЗ
		(ВЫБРАТЬ
			ЛичныеДанныеКандидатовОпытРаботы.Ссылка КАК Ссылка,
			МАКСИМУМ(ЛичныеДанныеКандидатовОпытРаботы.ДатаНачала) КАК ДатаНачала
		ИЗ
			Справочник.ЛичныеДанныеКандидатов.ОпытРаботы КАК ЛичныеДанныеКандидатовОпытРаботы
		ГДЕ
			ЛичныеДанныеКандидатовОпытРаботы.Ссылка В
					(ВЫБРАТЬ
						ВТДанныеКандидатов.ЛичныеДанные КАК ЛичныеДанные
					ИЗ
						ВТДанныеКандидатов КАК ВТДанныеКандидатов)
		
		СГРУППИРОВАТЬ ПО
			ЛичныеДанныеКандидатовОпытРаботы.Ссылка) КАК СамоеПоследнееМестоРаботы
			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЛичныеДанныеКандидатов.ОпытРаботы КАК ЛичныеДанныеКандидатовОпытРаботы
			ПО СамоеПоследнееМестоРаботы.Ссылка = ЛичныеДанныеКандидатовОпытРаботы.Ссылка
				И СамоеПоследнееМестоРаботы.ДатаНачала = ЛичныеДанныеКандидатовОпытРаботы.ДатаНачала
	ГДЕ
		ЛичныеДанныеКандидатовОпытРаботы.Ссылка В
				(ВЫБРАТЬ
					ВТДанныеКандидатов.ЛичныеДанные КАК ЛичныеДанные
				ИЗ
					ВТДанныеКандидатов КАК ВТДанныеКандидатов)
	
	СГРУППИРОВАТЬ ПО
		ЛичныеДанныеКандидатовОпытРаботы.Ссылка) КАК ПоследнееМестоРаботы
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЛичныеДанныеКандидатов.ОпытРаботы КАК ЛичныеДанныеКандидатовОпытРаботы
		ПО ПоследнееМестоРаботы.Ссылка = ЛичныеДанныеКандидатовОпытРаботы.Ссылка
			И ПоследнееМестоРаботы.НомерСтроки = ЛичныеДанныеКандидатовОпытРаботы.НомерСтроки

ИНДЕКСИРОВАТЬ ПО
	Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЛичныеДанныеКандидатовОпытРаботы.Ссылка КАК Ссылка,
	СУММА(РАЗНОСТЬДАТ(ЛичныеДанныеКандидатовОпытРаботы.ДатаНачала, ВЫБОР
				КОГДА ЛичныеДанныеКандидатовОпытРаботы.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
					ТОГДА &amp;ТекущаяДата
				ИНАЧЕ ЛичныеДанныеКандидатовОпытРаботы.ДатаОкончания
			КОНЕЦ, МЕСЯЦ)) КАК СтажМесяцев
ПОМЕСТИТЬ ВТСтажРаботы
ИЗ
	Справочник.ЛичныеДанныеКандидатов.ОпытРаботы КАК ЛичныеДанныеКандидатовОпытРаботы
ГДЕ
	ЛичныеДанныеКандидатовОпытРаботы.Ссылка В
			(ВЫБРАТЬ
				ВТДанныеКандидатов.ЛичныеДанные КАК ЛичныеДанные
			ИЗ
				ВТДанныеКандидатов КАК ВТДанныеКандидатов)

СГРУППИРОВАТЬ ПО
	ЛичныеДанныеКандидатовОпытРаботы.Ссылка

ИНДЕКСИРОВАТЬ ПО
	Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Кандидаты.Ссылка КАК Ссылка,
	Кандидаты.Ссылка КАК Кандидат,
	ВТДанныеКандидатов.Вакансия КАК Вакансия,
	ВТДанныеКандидатов.Источник КАК Источник,
	ВТДанныеКандидатов.Состояние КАК Состояние,
	ВТДанныеКандидатов.ДатаОтклика КАК ДатаОтклика,
	ВТДанныеКандидатов.Возраст КАК Возраст,
	ВТДанныеКандидатов.СопроводительноеПисьмо КАК СопроводительноеПисьмо,
	ВТКонтактнаяИнформация.Регион КАК Регион,
	ВТКонтактнаяИнформация.Телефон КАК Телефон,
	ВТКонтактнаяИнформация.Email КАК Email,
	ВТДанныеКандидатов.Рассмотрен КАК Рассмотрен,
	ВТДанныеКандидатов.Пол КАК Пол,
	ВТДанныеКандидатов.ОжидаемыйДоход КАК ОжидаемыйДоход,
	ВТДанныеКандидатов.ОжидаемыйДоходВВалютеПоУмолчанию КАК ОжидаемыйДоходВВалютеПоУмолчанию,
	ВТДанныеКандидатов.ВалютаДохода КАК ВалютаДохода,
	ВТПоследнееМестоРаботы.Компания КАК Компания,
	ВТПоследнееМестоРаботы.Должность КАК Должность,
	ВТПоследнееМестоРаботы.ДатаНачала КАК ДатаНачала,
	ВТПоследнееМестоРаботы.ДатаОкончания КАК ДатаОкончания,
	ВЫБОР
		КОГДА ВТСтажРаботы.СтажМесяцев ЕСТЬ NULL
			ТОГДА &amp;НеУказан
		КОГДА ВТСтажРаботы.СтажМесяцев &lt; 12
			ТОГДА &amp;МеньшеГода
		ИНАЧЕ ВЫРАЗИТЬ(ВЫБОР
					КОГДА (ВЫРАЗИТЬ(ВТСтажРаботы.СтажМесяцев / 12 КАК ЧИСЛО(15, 0))) > ВТСтажРаботы.СтажМесяцев / 12
						ТОГДА ВТСтажРаботы.СтажМесяцев / 12 - 1
					ИНАЧЕ ВТСтажРаботы.СтажМесяцев / 12
				КОНЕЦ КАК ЧИСЛО(15, 0))
	КОНЕЦ КАК СтажРаботы
ИЗ
	ВТДанныеКандидатов КАК ВТДанныеКандидатов
		ЛЕВОЕ СОЕДИНЕНИЕ ВТПоследнееМестоРаботы КАК ВТПоследнееМестоРаботы
		ПО ВТДанныеКандидатов.ЛичныеДанные = ВТПоследнееМестоРаботы.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Кандидаты КАК Кандидаты
		ПО ВТДанныеКандидатов.Кандидат = Кандидаты.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ ВТСтажРаботы КАК ВТСтажРаботы
		ПО ВТДанныеКандидатов.ЛичныеДанные = ВТСтажРаботы.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ ВТКонтактнаяИнформация КАК ВТКонтактнаяИнформация
		ПО ВТДанныеКандидатов.ЛичныеДанные = ВТКонтактнаяИнформация.ЛичныеДанные</queryText>
