    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ПубликацияВакансий.Вакансия КАК Вакансия,
	ПубликацияВакансий.МестоПубликации КАК МестоПубликации,
	ПубликацияВакансий.АдресПубликации КАК АдресПубликации,
	ПубликацияВакансий.ИдентификаторВакансии КАК ИдентификаторВакансии,
	ПубликацияВакансий.ДатаПубликации КАК ДатаПубликации,
	ПубликацияВакансий.ДатаОбновления КАК ДатаОбновления,
	ПубликацияВакансий.ДатаСнятияСПубликации КАК ДатаСнятияСПубликации,
	ВЫРАЗИТЬ(&quot;&quot;&quot;&quot; КАК СТРОКА(40)) КАК ДатаСобытияСтрокой,
	ПубликацияВакансий.Ответственный КАК Ответственный,
	ПубликацияВакансий.Регион КАК Регион
ИЗ
	РегистрСведений.ПубликацияВакансий КАК ПубликацияВакансий
ГДЕ
	ТИПЗНАЧЕНИЯ(ПубликацияВакансий.МестоПубликации) = ТИП(Справочник.ИсточникиИнформацииОКандидатах)</queryText>
