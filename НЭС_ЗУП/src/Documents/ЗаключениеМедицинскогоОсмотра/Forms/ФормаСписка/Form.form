    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ДокументЗаключениеМедицинскогоОсмотра.Ссылка КАК Ссылка,
	ДокументЗаключениеМедицинскогоОсмотра.ПометкаУдаления КАК ПометкаУдаления,
	ДокументЗаключениеМедицинскогоОсмотра.Номер КАК Номер,
	ДокументЗаключениеМедицинскогоОсмотра.Дата КАК Дата,
	ДокументЗаключениеМедицинскогоОсмотра.Проведен КАК Проведен,
	ДокументЗаключениеМедицинскогоОсмотра.Организация КАК Организация,
	ДокументЗаключениеМедицинскогоОсмотра.ФизическоеЛицо КАК ФизическоеЛицо,
	ДокументЗаключениеМедицинскогоОсмотра.РабочееМесто КАК РабочееМесто,
	ДокументЗаключениеМедицинскогоОсмотра.Направление КАК Направление,
	ДокументЗаключениеМедицинскогоОсмотра.ДатаОсмотра КАК ДатаОсмотра,
	ДокументЗаключениеМедицинскогоОсмотра.ВидОсмотра КАК ВидОсмотра,
	ДокументЗаключениеМедицинскогоОсмотра.ТипОсмотра КАК ТипОсмотра,
	ДокументЗаключениеМедицинскогоОсмотра.РезультатОсмотра КАК РезультатОсмотра,
	ДокументЗаключениеМедицинскогоОсмотра.ПояснениеРезультата КАК ПояснениеРезультата,
	ДокументЗаключениеМедицинскогоОсмотра.Ответственный КАК Ответственный,
	ДокументЗаключениеМедицинскогоОсмотра.Комментарий КАК Комментарий,
	ВЫБОР
		КОГДА НаличиеФайлов.ЕстьФайлы ЕСТЬ NULL
			ТОГДА 0
		КОГДА НаличиеФайлов.ЕстьФайлы
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ЕстьФайлы,
	0 КАК ПредупреждениеКартинка
ИЗ
	Документ.ЗаключениеМедицинскогоОсмотра КАК ДокументЗаключениеМедицинскогоОсмотра
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиОхраныТруда КАК НастройкиОхраныТруда
		ПО ДокументЗаключениеМедицинскогоОсмотра.Организация = НастройкиОхраныТруда.Организация
		И ((НЕ НастройкиОхраныТруда.ИспользоватьРабочиеМестаОхраныТруда)
		ИЛИ (НЕ НастройкиОхраныТруда.ИспользоватьМедицинскиеОсмотры))
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаличиеФайлов КАК НаличиеФайлов
		ПО ДокументЗаключениеМедицинскогоОсмотра.Ссылка = НаличиеФайлов.ОбъектСФайлами}
ГДЕ
	НастройкиОхраныТруда.ИспользоватьРабочиеМестаОхраныТруда ЕСТЬ NULL</queryText>
