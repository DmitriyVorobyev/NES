    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ЖурналДокументовБронированиеГражданПребывающихВЗапасе.Ссылка КАК Ссылка,
	ЖурналДокументовБронированиеГражданПребывающихВЗапасе.Дата КАК Дата,
	НАЧАЛОПЕРИОДА(ЖурналДокументовБронированиеГражданПребывающихВЗапасе.Дата, ДЕНЬ) КАК ДатаДокумента,
	ЖурналДокументовБронированиеГражданПребывающихВЗапасе.ПометкаУдаления КАК ПометкаУдаления,
	ЖурналДокументовБронированиеГражданПребывающихВЗапасе.Номер КАК Номер,
	ЖурналДокументовБронированиеГражданПребывающихВЗапасе.Проведен КАК Проведен,
	ЖурналДокументовБронированиеГражданПребывающихВЗапасе.Организация КАК Организация,
	ЖурналДокументовБронированиеГражданПребывающихВЗапасе.Сотрудники КАК Сотрудники,
	ЖурналДокументовБронированиеГражданПребывающихВЗапасе.Ответственный КАК Ответственный,
	ЖурналДокументовБронированиеГражданПребывающихВЗапасе.Комментарий КАК Комментарий,
	ЖурналДокументовБронированиеГражданПребывающихВЗапасе.Тип КАК Тип
ИЗ
	ЖурналДокументов.БронированиеГражданПребывающихВЗапасе КАК ЖурналДокументовБронированиеГражданПребывающихВЗапасе
{ГДЕ
	(ИСТИНА В
			(ВЫБРАТЬ ПЕРВЫЕ 1
				ИСТИНА
			ИЗ
				РегистрСведений.СоставДокументовЗарплатаКадры КАК СоставДокументовЗарплатаКадры
			ГДЕ
				СоставДокументовЗарплатаКадры.ФизическоеЛицо = &amp;ФизическоеЛицо
				И ЖурналДокументовБронированиеГражданПребывающихВЗапасе.Ссылка = СоставДокументовЗарплатаКадры.ДокументФизическогоЛица))}</queryText>
      <mainTable>DocumentJournal.БронированиеГражданПребывающихВЗапасе</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
