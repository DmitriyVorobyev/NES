  <attributes>
    <name>СписокПользователи</name>
    <title>
      <key>ru</key>
      <value>Список пользователи</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокПользователи.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	Пользователи.Ссылка,
	Пользователи.ПометкаУдаления,
	Пользователи.Предопределенный,
	Пользователи.Наименование,
	ВЫБОР
		КОГДА Пользователи.ПометкаУдаления
			ТОГДА 0
		ИНАЧЕ 1
	КОНЕЦ КАК НомерКартинки
ИЗ
	Справочник.Пользователи КАК Пользователи
ГДЕ
	Пользователи.Недействителен = ЛОЖЬ
	И Пользователи.Служебный = ЛОЖЬ
	И Пользователи.ПометкаУдаления = ЛОЖЬ</queryText>
      <mainTable>Catalog.Пользователи</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
  <attributes>
    <name>СписокРоли</name>
    <title>
      <key>ru</key>
      <value>Список роли</value>
    </title>
    <id>3</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРоли.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРоли.ИспользуетсяСОбъектамиАдресации</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокРоли.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	СправочникРолиИсполнителей.Ссылка КАК Ссылка,
	СправочникРолиИсполнителей.ВерсияДанных КАК ВерсияДанных,
	СправочникРолиИсполнителей.ПометкаУдаления КАК ПометкаУдаления,
	СправочникРолиИсполнителей.Предопределенный КАК Предопределенный,
	СправочникРолиИсполнителей.Код КАК Код,
	СправочникРолиИсполнителей.Наименование КАК Наименование,
	СправочникРолиИсполнителей.ИспользуетсяБезОбъектовАдресации КАК ИспользуетсяБезОбъектовАдресации,
	СправочникРолиИсполнителей.КраткоеПредставление КАК КраткоеПредставление,
	СправочникРолиИсполнителей.ИспользуетсяСОбъектамиАдресации КАК ИспользуетсяСОбъектамиАдресации,
	СправочникРолиИсполнителей.Комментарий КАК Комментарий,
	СправочникРолиИсполнителей.ТипыДополнительногоОбъектаАдресации КАК ТипыДополнительногоОбъектаАдресации,
	СправочникРолиИсполнителей.ТипыОсновногоОбъектаАдресации КАК ТипыОсновногоОбъектаАдресации,
	СправочникРолиИсполнителей.ВнешняяРоль КАК ВнешняяРоль,
	СправочникРолиИсполнителей.УзелОбмена КАК УзелОбмена,
	ВЫБОР
		КОГДА СправочникРолиИсполнителей.ИспользуетсяСОбъектамиАдресации
			ТОГДА ИСТИНА
		КОГДА СправочникРолиИсполнителей.Ссылка В
				(ВЫБРАТЬ ПЕРВЫЕ 1
					РегистрСведений.ИсполнителиЗадач.РольИсполнителя.Ссылка
				ИЗ
					РегистрСведений.ИсполнителиЗадач
				ГДЕ
					РегистрСведений.ИсполнителиЗадач.РольИсполнителя = СправочникРолиИсполнителей.Ссылка)
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ЕстьИсполнители,
	ВЫБОР
		КОГДА СправочникРолиИсполнителей.Предопределенный
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК Картинка
ИЗ
	Справочник.РолиИсполнителей КАК СправочникРолиИсполнителей

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	&quot;Автор документа&quot;,
	NULL,
	NULL,
	NULL,
	NULL,
	&quot;Автор документа&quot;,
	NULL,
	NULL,
	NULL,
	&quot;Пользователь, создавший документ&quot;,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	2
ГДЕ
	&amp;ОткрытиеИзФормыШаблона

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	&quot;Пользователь&quot;,
	NULL,
	NULL,
	NULL,
	NULL,
	&quot;Пользователь, указанный в реквизите&quot;,
	NULL,
	NULL,
	NULL,
	&quot;Пользователь, указанный в реквизите документа&quot;,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	2
ГДЕ
	&amp;ОткрытиеИзФормыШаблона

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	&quot;Функция&quot;,
	NULL,
	NULL,
	NULL,
	NULL,
	&quot;Дополнительная функция&quot;,
	NULL,
	NULL,
	NULL,
	&quot;Дополнительная функция, описанная на встроенном языке&quot;,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	3
ГДЕ
	&amp;ОткрытиеИзФормыШаблона
	И &amp;ЕстьПодходящиеФункции</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <keyField>Ссылка</keyField>
    </extInfo>
  </attributes>
