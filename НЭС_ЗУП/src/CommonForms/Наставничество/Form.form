  <attributes>
    <name>ЯвляетсяНаставляемым</name>
    <id>3</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ РАЗЛИЧНЫЕ
	НаставничествоСрезПоследних.Организация КАК Организация,
	НаставничествоСрезПоследних.Наставник КАК Наставник,
	НаставничествоСрезПоследних.ДатаНачала КАК ДатаНачала,
	НаставничествоСрезПоследних.ДатаОкончания КАК ДатаОкончания,
	НаставничествоСрезПоследних.Регистратор КАК Регистратор,
	ЕСТЬNULL(НазначениеНаставника.НазначитьДоплату, ЛОЖЬ) КАК НазначенаДоплата,
	ЕСТЬNULL(НазначениеНаставника.Начисление, ЗНАЧЕНИЕ(ПланВидовРасчета.Начисления.ПустаяСсылка)) КАК Начисление
ИЗ
	РегистрСведений.Наставничество.СрезПоследних(
			КОНЕЦПЕРИОДА(&amp;ДатаСведений, ДЕНЬ),
			Наставляемый = &amp;УчастникПроцессаНаставничества
				ИЛИ ВЫРАЗИТЬ(Наставляемый КАК Справочник.Сотрудники).ФизическоеЛицо = &amp;УчастникПроцессаНаставничества) КАК НаставничествоСрезПоследних
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НазначениеНаставника КАК НазначениеНаставника
		ПО НаставничествоСрезПоследних.Регистратор = НазначениеНаставника.Ссылка
ГДЕ
	НаставничествоСрезПоследних.Назначен
	И (НаставничествоСрезПоследних.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
			ИЛИ КОНЕЦПЕРИОДА(НаставничествоСрезПоследних.ДатаОкончания, ДЕНЬ) >= КОНЕЦПЕРИОДА(&amp;ДатаСведений, ДЕНЬ))</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
