  <attributes>
    <name>ЯвляетсяНаставником</name>
    <title>
      <key>ru</key>
      <value>Является наставником</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ РАЗЛИЧНЫЕ
	НаставничествоСрезПоследних.Организация КАК Организация,
	НаставничествоСрезПоследних.Наставник КАК Наставник,
	НаставничествоСрезПоследних.Наставляемый КАК Наставляемый,
	НаставничествоСрезПоследних.ДатаНачала КАК ДатаНачала,
	НаставничествоСрезПоследних.ДатаОкончания КАК ДатаОкончания,
	НаставничествоСрезПоследних.Регистратор КАК Регистратор,
	ЕСТЬNULL(НазначениеНаставника.НазначитьДоплату, ЛОЖЬ) КАК НазначенаДоплата,
	ЕСТЬNULL(НазначениеНаставника.Начисление, ЗНАЧЕНИЕ(ПланВидовРасчета.Начисления.ПустаяСсылка)) КАК Начисление
ИЗ
	РегистрСведений.Наставничество.СрезПоследних(
			КОНЕЦПЕРИОДА(&amp;ДатаСведений, ДЕНЬ),
			Наставник = &amp;УчастникПроцессаНаставничества
				ИЛИ ВЫРАЗИТЬ(Наставник КАК Справочник.Сотрудники).ФизическоеЛицо = &amp;УчастникПроцессаНаставничества) КАК НаставничествоСрезПоследних
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.НазначениеНаставника КАК НазначениеНаставника
		ПО НаставничествоСрезПоследних.Регистратор = НазначениеНаставника.Ссылка
ГДЕ
	НаставничествоСрезПоследних.Назначен
	И (НаставничествоСрезПоследних.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
			ИЛИ КОНЕЦПЕРИОДА(НаставничествоСрезПоследних.ДатаОкончания, ДЕНЬ) >= КОНЕЦПЕРИОДА(&amp;ДатаСведений, ДЕНЬ))</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Организация</dataPath>
        <field>Организация</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ДатаНачала</dataPath>
        <field>ДатаНачала</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Наставник</dataPath>
        <field>Наставник</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Наставляемый</dataPath>
        <field>Наставляемый</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ДатаОкончания</dataPath>
        <field>ДатаОкончания</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Регистратор</dataPath>
        <field>Регистратор</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>ПозицияРезерва</dataPath>
        <field>ПозицияРезерва</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>НазначенаДоплата</dataPath>
        <field>НазначенаДоплата</field>
        <title>
          <localValue>
            <content>
              <key>ru</key>
              <value>Назначена доплата</value>
            </content>
          </localValue>
        </title>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Начисление</dataPath>
        <field>Начисление</field>
        <title>
          <localValue>
            <content>
              <key>ru</key>
              <value>Начисление</value>
            </content>
          </localValue>
        </title>
      </fields>
      <parameters>
        <name>Период</name>
        <title>
          <localValue>
            <content>
              <key>ru</key>
              <value>Период</value>
            </content>
          </localValue>
        </title>
        <valueType>
          <types>Date</types>
          <dateQualifiers/>
        </valueType>
        <values xsi:type="core:DateValue">
          <value>0001-01-01T00:00:00</value>
        </values>
        <useRestriction>true</useRestriction>
      </parameters>
      <parameters>
        <name>УчастникПроцессаНаставничества</name>
        <title>
          <localValue>
            <content>
              <key>ru</key>
              <value>Участник процесса наставничества</value>
            </content>
          </localValue>
        </title>
        <valueType>
          <types>CatalogRef.ФизическиеЛица</types>
