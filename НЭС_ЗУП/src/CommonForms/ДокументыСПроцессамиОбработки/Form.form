    <name>Список</name>
    <title>
      <key>ru</key>
      <value>Список</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	ЗадачаПоОбработкеДокумента.Предмет КАК Предмет,
	ЗадачаПоОбработкеДокумента.Исполнитель КАК Исполнитель,
	ЗадачаПоОбработкеДокумента.РольИсполнителя КАК РольИсполнителя,
	ЗадачаПоОбработкеДокумента.ОсновнойОбъектАдресации КАК ОсновнойОбъектАдресации,
	ЗадачаПоОбработкеДокумента.ДополнительныйОбъектАдресации КАК ДополнительныйОбъектАдресации
ПОМЕСТИТЬ НевыполненныеЗадачи
ИЗ
	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачаПоОбработкеДокумента
ГДЕ
	НЕ ЗадачаПоОбработкеДокумента.Выполнена
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ТекущиеСтатусыДокументов.Предмет КАК Предмет,
	ТекущиеСтатусыДокументов.Статус КАК Статус,
	ТекущиеСтатусыДокументов.Шаблон КАК Шаблон,
	ВЫБОР
		КОГДА НевыполненныеЗадачи.Предмет ЕСТЬ NULL
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ОбработкаЗавершена,
	ВЫБОР
		КОГДА НевыполненныеЗадачи.Предмет ЕСТЬ NULL
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК ОбработкаНезавершена,
	ТИПЗНАЧЕНИЯ(ТекущиеСтатусыДокументов.Предмет) КАК ТипДокумента,
	ЛОЖЬ КАК Флаг,
	НевыполненныеЗадачи.Исполнитель КАК Исполнитель,
	НевыполненныеЗадачи.РольИсполнителя КАК РольИсполнителя,
	НевыполненныеЗадачи.ОсновнойОбъектАдресации КАК ОсновнойОбъектАдресации,
	НевыполненныеЗадачи.ДополнительныйОбъектАдресации КАК ДополнительныйОбъектАдресации
ИЗ
	РегистрСведений.ТекущиеСтатусыДокументов КАК ТекущиеСтатусыДокументов
		ЛЕВОЕ СОЕДИНЕНИЕ НевыполненныеЗадачи КАК НевыполненныеЗадачи
		ПО ТекущиеСтатусыДокументов.Предмет = НевыполненныеЗадачи.Предмет</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
