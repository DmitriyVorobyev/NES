  <attributes>
    <name>Приглашения</name>
    <title>
      <key>ru</key>
      <value>Приглашения</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Приглашения.КоличествоУчастников</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Приглашения.Отклонило</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	УчастникиЭтапаРаботыСКандидатом.Кандидат КАК Кандидат,
	УчастникиЭтапаРаботыСКандидатом.ЭтапРаботы КАК ЭтапРаботы
ПОМЕСТИТЬ ВТ_ОтклоненныеЭтапы
ИЗ
	РегистрСведений.УчастникиЭтапаРаботыСКандидатом КАК УчастникиЭтапаРаботыСКандидатом
ГДЕ
	УчастникиЭтапаРаботыСКандидатом.СостояниеПриглашения = ЗНАЧЕНИЕ(Перечисление.СостоянияПриглашений.Отклонено)
	И УчастникиЭтапаРаботыСКандидатом.Обязательный
	И УчастникиЭтапаРаботыСКандидатом.Кандидат.Ответственный = &amp;Ответственный

СГРУППИРОВАТЬ ПО
	УчастникиЭтапаРаботыСКандидатом.Кандидат,
	УчастникиЭтапаРаботыСКандидатом.ЭтапРаботы
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ОтклоненныеЭтапы.Кандидат КАК Кандидат,
	ВТ_ОтклоненныеЭтапы.ЭтапРаботы КАК ЭтапРаботы,
	МАКСИМУМ(РаботаСКандидатами.Период) КАК ДатаНачала,
	КОЛИЧЕСТВО(УчастникиЭтапаРаботыСКандидатом.СостояниеПриглашения) КАК КоличествоУчастников,
	СУММА(ВЫБОР
			КОГДА УчастникиЭтапаРаботыСКандидатом.СостояниеПриглашения = ЗНАЧЕНИЕ(Перечисление.СостоянияПриглашений.Отклонено)
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК Отклонило,
	ВЫРАЗИТЬ(&quot;&quot; КАК СТРОКА(1000)) КАК Состояние
ИЗ
	ВТ_ОтклоненныеЭтапы КАК ВТ_ОтклоненныеЭтапы
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РаботаСКандидатами КАК РаботаСКандидатами
		ПО ВТ_ОтклоненныеЭтапы.Кандидат = РаботаСКандидатами.Кандидат
			И ВТ_ОтклоненныеЭтапы.ЭтапРаботы = РаботаСКандидатами.ЭтапРаботы
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчастникиЭтапаРаботыСКандидатом КАК УчастникиЭтапаРаботыСКандидатом
		ПО ВТ_ОтклоненныеЭтапы.Кандидат = УчастникиЭтапаРаботыСКандидатом.Кандидат
			И ВТ_ОтклоненныеЭтапы.ЭтапРаботы = УчастникиЭтапаРаботыСКандидатом.ЭтапРаботы

СГРУППИРОВАТЬ ПО
	ВТ_ОтклоненныеЭтапы.Кандидат,
	ВТ_ОтклоненныеЭтапы.ЭтапРаботы</queryText>
      <mainTable>InformationRegister.РаботаСКандидатами</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
