    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ИсполнителиЗадач.РольИсполнителя КАК РольИсполнителя,
	ИсполнителиЗадач.ОсновнойОбъектАдресации КАК ОсновнойОбъектАдресации,
	ИсполнителиЗадач.ДополнительныйОбъектАдресации КАК ДополнительныйОбъектАдресации
ПОМЕСТИТЬ РолиКуратора
ИЗ
	РегистрСведений.ИсполнителиЗадач КАК ИсполнителиЗадач
{ГДЕ
	(ИсполнителиЗадач.Исполнитель = &amp;Исполнитель)}

ИНДЕКСИРОВАТЬ ПО
	ДополнительныйОбъектАдресации,
	ОсновнойОбъектАдресации,
	РольИсполнителя
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	РегистрСведенийРегламентныеИнтервалыДокументов.Предмет КАК Предмет,
	РегистрСведенийРегламентныеИнтервалыДокументов.РегламентныйИнтервал КАК РегламентныйИнтервал,
	РегистрСведенийРегламентныеИнтервалыДокументов.НомерИтерации КАК НомерИтерации,
	РегистрСведенийРегламентныеИнтервалыДокументов.Состояние КАК Состояние,
	РегистрСведенийРегламентныеИнтервалыДокументов.ДатаСоздания КАК ДатаСоздания,
	РегистрСведенийРегламентныеИнтервалыДокументов.Срок КАК Срок,
	РегистрСведенийРегламентныеИнтервалыДокументов.ДатаВыполнения КАК ДатаВыполнения,
	РегистрСведенийРегламентныеИнтервалыДокументов.ИдентификаторКонечногоЭтапа КАК ИдентификаторКонечногоЭтапа,
	ТекущиеСтатусыДокументов.Статус КАК Статус,
	РегламентныеИнтервалы.Куратор КАК Куратор,
	РегламентныеИнтервалы.ОсновнойОбъектАдресацииКуратора КАК ОсновнойОбъектАдресацииКуратора,
	РегламентныеИнтервалы.ДополнительныйОбъектАдресацииКуратора КАК ДополнительныйОбъектАдресацииКуратора
ИЗ
	РегистрСведений.РегламентныеИнтервалыДокументов КАК РегистрСведенийРегламентныеИнтервалыДокументов
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТекущиеСтатусыДокументов КАК ТекущиеСтатусыДокументов
		ПО РегистрСведенийРегламентныеИнтервалыДокументов.Предмет = ТекущиеСтатусыДокументов.Предмет
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РегламентныеИнтервалы КАК РегламентныеИнтервалы
		ПО РегистрСведенийРегламентныеИнтервалыДокументов.РегламентныйИнтервал = РегламентныеИнтервалы.Ссылка
ГДЕ
	РегистрСведенийРегламентныеИнтервалыДокументов.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияРегламентныхИнтервалов.Активен)
{ГДЕ
	(РегламентныеИнтервалы.Куратор = &amp;Исполнитель
			ИЛИ (РегламентныеИнтервалы.Куратор, РегламентныеИнтервалы.ОсновнойОбъектАдресацииКуратора, РегламентныеИнтервалы.ДополнительныйОбъектАдресацииКуратора) В
				(ВЫБРАТЬ
					РолиКуратора.РольИсполнителя,
					РолиКуратора.ОсновнойОбъектАдресации,
					РолиКуратора.ДополнительныйОбъектАдресации
				ИЗ
					РолиКуратора))}</queryText>
      <mainTable>InformationRegister.РегламентныеИнтервалыДокументов</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
