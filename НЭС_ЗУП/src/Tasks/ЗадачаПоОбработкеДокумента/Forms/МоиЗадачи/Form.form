    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ЗадачиПоИсполнителю.Ссылка КАК Ссылка,
	ЗадачиПоИсполнителю.ПометкаУдаления КАК ПометкаУдаления,
	ЗадачиПоИсполнителю.Номер КАК Номер,
	ЗадачиПоИсполнителю.Дата КАК Дата,
	ЗадачиПоИсполнителю.Наименование КАК Наименование,
	ЗадачиПоИсполнителю.Выполнена КАК Выполнена,
	ЗадачиПоИсполнителю.Прервана КАК Прервана,
	ЗадачиПоИсполнителю.ДатаИсполнения КАК ДатаИсполнения,
	ЗадачиПоИсполнителю.Автор КАК Автор,
	ЗадачиПоИсполнителю.Исполнитель КАК Исполнитель,
	ЗадачиПоИсполнителю.РольИсполнителя КАК РольИсполнителя,
	ЗадачиПоИсполнителю.ПринятаКИсполнению КАК ПринятаКИсполнению,
	ЗадачиПоИсполнителю.Предмет КАК Предмет,
	ТИПЗНАЧЕНИЯ(ЗадачиПоИсполнителю.Предмет) КАК ТипДокумента_,
	ЗадачиПоИсполнителю.Этап КАК Этап,
	ЗадачиПоИсполнителю.Шаблон КАК Шаблон,
	ЗадачиПоИсполнителю.ИдентификаторЭтапа КАК ИдентификаторЭтапа,
	ЗадачиПоИсполнителю.Статус КАК Статус,
	ЗадачиПоИсполнителю.РезультатВыполнения КАК РезультатВыполнения,
	ЗадачиПоИсполнителю.ТипПредметаСтрокой КАК ТипДокумента,
	ИсторияИзмененияСтатусовДокументов.Статус КАК УстановленСтатус,
	ЗадачиПоИсполнителю.НеВыполненаИзЗаОшибки КАК НеВыполненаИзЗаОшибки,
	ЗадачиПоИсполнителю.ИсполнительНазначенПринудительно КАК ИсполнительНазначенПринудительно,
	ЗадачиПоИсполнителю.ДатаОтсчетаПредельногоСрокаОбработки КАК ДатаОтсчетаПредельногоСрокаОбработки,
	ЗадачиПоИсполнителю.СрокНапоминанияОбработки КАК СрокНапоминанияОбработки,
	ЗадачиПоИсполнителю.СрокОбработки КАК СрокОбработки,
	ЕСТЬNULL(СоставПачекВыполняемыхЗадач.ИдентификаторПачки, НЕОПРЕДЕЛЕНО) КАК ИдентификаторПачкиЗадач,
	ВЫБОР
		КОГДА ЗадачиПоИсполнителю.Выполнена
			ТОГДА 1
		КОГДА НЕ СоставПачекВыполняемыхЗадач.Задача ЕСТЬ NULL
			ТОГДА 3
		КОГДА ЗадачиПоИсполнителю.Исполнитель &lt;> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
			ТОГДА ВЫБОР
					КОГДА ЗадачиПоИсполнителю.НеВыполненаИзЗаОшибки
						ТОГДА 5
					ИНАЧЕ 4
				КОНЕЦ
		КОГДА ЗадачиПоИсполнителю.НеВыполненаИзЗаОшибки
			ТОГДА 2
		ИНАЧЕ 0
	КОНЕЦ КАК НомерКартинки,
	ЗадачиПоИсполнителю.СрокВыполнения КАК СрокВыполнения,
	ЗадачиПоИсполнителю.СрокНапоминания КАК СрокНапоминания,
	ЭтапыРегламентногоИнтервалаДокумента.СрокПоРегламенту КАК СрокПоРегламенту,
	ЭтапыРегламентногоИнтервалаДокумента.СрокНапоминания КАК СрокНапоминанияРегламент,
	ВЫРАЗИТЬ(&amp;ТекущаяДата КАК Дата) КАК ТекущаяДата
{ВЫБРАТЬ
	Предмет}
ИЗ
	Задача.ЗадачаПоОбработкеДокумента КАК ЗадачиПоИсполнителю
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсторияИзмененияСтатусовДокументов КАК ИсторияИзмененияСтатусовДокументов
		ПО ЗадачиПоИсполнителю.Предмет = ИсторияИзмененияСтатусовДокументов.Предмет
			И ЗадачиПоИсполнителю.Ссылка = ИсторияИзмененияСтатусовДокументов.Установил
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставПачекВыполняемыхЗадач КАК СоставПачекВыполняемыхЗадач
		ПО ЗадачиПоИсполнителю.Ссылка = СоставПачекВыполняемыхЗадач.Задача
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЭтапыРегламентногоИнтервалаДокумента КАК ЭтапыРегламентногоИнтервалаДокумента
		ПО ЗадачиПоИсполнителю.РегламентныйИнтервал = ЭтапыРегламентногоИнтервалаДокумента.РегламентныйИнтервал
			И ЗадачиПоИсполнителю.НомерИтерации = ЭтапыРегламентногоИнтервалаДокумента.НомерИтерации
			И ЗадачиПоИсполнителю.Предмет = ЭтапыРегламентногоИнтервалаДокумента.Предмет
			И ЗадачиПоИсполнителю.ИдентификаторЭтапа = ЭтапыРегламентногоИнтервалаДокумента.ИдентификаторЭтапа
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсполнителиЗадач КАК ИсполнителиЗадач
		ПО (ИсполнителиЗадач.Исполнитель = &amp;Исполнитель)
			И ЗадачиПоИсполнителю.РольИсполнителя = ИсполнителиЗадач.РольИсполнителя
			И ЗадачиПоИсполнителю.ОсновнойОбъектАдресации = ИсполнителиЗадач.ОсновнойОбъектАдресации
			И ЗадачиПоИсполнителю.ДополнительныйОбъектАдресации = ИсполнителиЗадач.ДополнительныйОбъектАдресации
ГДЕ
	(ЗадачиПоИсполнителю.Исполнитель = &amp;Исполнитель
			ИЛИ (ЗадачиПоИсполнителю.Исполнитель = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
				И НЕ ИсполнителиЗадач.Исполнитель ЕСТЬ NULL))
					
{ГДЕ
	ЗадачиПоИсполнителю.Предмет}</queryText>
