    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>РабочиеМеста.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	РабочиеМестаСправочник.Ссылка КАК Ссылка,
	РабочиеМестаСправочник.Наименование КАК Наименование,
	РабочиеМестаСправочник.Владелец КАК Организация,
	РабочиеМестаСправочник.Подразделение КАК Подразделение,
	РабочиеМестаСправочник.Должность КАК Должность,
	ВЫБОР
		КОГДА ИСТИНА В
			(ВЫБРАТЬ ПЕРВЫЕ 1
				ИСТИНА
			ИЗ
				Справочник.ПрограммыОбученияСотрудниковПоОхранеТруда КАК ПрограммыОбучения
					ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПрограммыОбученияСотрудниковПоОхранеТруда.РабочиеМеста КАК РабочиеМестаПрограммОбучения
					ПО ПрограммыОбучения.Ссылка = РабочиеМестаПрограммОбучения.Ссылка
			ГДЕ
				ПрограммыОбучения.Ссылка = &amp;ПрограммаОбучения
				И ПрограммыОбучения.КонтролироватьПроведение
				И ВЫБОР
					КОГДА ПрограммыОбучения.ИспользоватьДляВсехРабочихМест
						ТОГДА ИСТИНА
					ИНАЧЕ РабочиеМестаПрограммОбучения.РабочееМесто = РабочиеМестаСправочник.Ссылка
				КОНЕЦ)
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ЕстьОбучение,
	РабочиеМестаСправочник.Подразделение.РеквизитДопУпорядочиванияИерархического КАК
		ПодразделениеРеквизитДопУпорядочиванияИерархического,
	РабочиеМестаСправочник.Должность.РеквизитДопУпорядочивания КАК ДолжностьРеквизитДопУпорядочивания
ИЗ
	Справочник.РабочиеМестаОхраныТруда КАК РабочиеМестаСправочник
ГДЕ
	РабочиеМестаСправочник.ЭтоГруппа = ЛОЖЬ</queryText>
      <mainTable>Catalog.РабочиеМестаОхраныТруда</mainTable>
