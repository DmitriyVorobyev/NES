            <id>378</id>
            <title>
              <key>ru</key>
              <value>Разрешить использование расширения браузера</value>
            </title>
            <visible>true</visible>
            <enabled>true</enabled>
            <userVisible>
              <common>true</common>
            </userVisible>
            <dataPath xsi:type="form:DataPath">
              <segments>ИспользоватьЗагрузкуКандидатовИзИнтернета</segments>
            </dataPath>
            <titleLocation>Right</titleLocation>
