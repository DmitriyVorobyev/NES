            <name>ПояснениеИспользоватьРабочиеМестаОхраныТрудаКонтекстноеМеню</name>
            <id>76</id>
            <autoFill>true</autoFill>
          </contextMenu>
          <formatted>true</formatted>
          <type>Label</type>
          <autoMaxHeight>true</autoMaxHeight>
