    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ВыдачиСИЗ.ВыданыСИЗ</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ВыдачиСИЗ.ВыдачаСИЗ</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ВыдачиСИЗ.ГоловнаяОрганизация</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ВыдачиСИЗ.ДатаСледующейВыдачи</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ВыдачиСИЗ.ЗаказНаВыдачу</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ВыдачиСИЗ.Организация</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ВыдачиСИЗ.ПредупреждениеКартинка</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ВыдачиСИЗ.РабочееМесто</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ВыдачиСИЗ.РезультатВыдачи</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ВыдачиСИЗ.СпособВыдачи</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ РАЗЛИЧНЫЕ
	ВыдачиСИЗ.ДатаСледующейВыдачи КАК ДатаСледующейВыдачи,
	ВыдачиСИЗ.ФизическоеЛицо КАК ФизическоеЛицо,
	ВыдачиСИЗ.РабочееМесто КАК РабочееМесто,
	ВыдачиСИЗ.РезультатВыдачи КАК РезультатВыдачи,
	ВыдачиСИЗ.ДатаВыдачи КАК ДатаВыдачи,
	ЕСТЬNULL(АктуальныеЗаказыНаВыдачуСИЗ.ЗаказНаВыдачуСИЗ, ВыдачиСИЗ.ЗаказНаВыдачуСИЗ) КАК ЗаказНаВыдачу,
	ВЫБОР
		КОГДА АктуальныеЗаказыНаВыдачуСИЗ.ЗаказНаВыдачуСИЗ ЕСТЬ НЕ NULL
			ТОГДА ЗНАЧЕНИЕ(Документ.ВыдачаСИЗ.ПустаяСсылка)
		ИНАЧЕ ВыдачиСИЗ.ВыдачаСИЗ
	КОНЕЦ КАК ВыдачаСИЗ,
	ВыдачиСИЗ.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
	ВыдачиСИЗ.РабочееМесто.Владелец КАК Организация,
	ВыдачиСИЗ.РабочееМесто.Подразделение КАК Подразделение,
	ВЫБОР
		КОГДА АктуальныеЗаказыНаВыдачуСИЗ.ЗаказНаВыдачуСИЗ ЕСТЬ НЕ NULL
		ИЛИ ВыдачиСИЗ.ВыдачаСИЗ = ЗНАЧЕНИЕ(Документ.ВыдачаСИЗ.ПустаяСсылка)
		ИЛИ ВыдачиСИЗ.ВыдачаСИЗ ЕСТЬ NULL
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК ВыданыСИЗ,
	ПериодичностьВыдачиСИЗРабочихМест.СпособВыдачи КАК СпособВыдачи,
	&quot;&quot; КАК СостояниеВыдачи,
	0 КАК ПредупреждениеКартинка
ИЗ
	РегистрСведений.ВыдачиСИЗ КАК ВыдачиСИЗ
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПериодичностьВыдачиСИЗРабочихМест КАК ПериодичностьВыдачиСИЗРабочихМест
		ПО ВыдачиСИЗ.РабочееМесто = ПериодичностьВыдачиСИЗРабочихМест.РабочееМесто
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АктуальныеЗаказыНаВыдачуСИЗ КАК АктуальныеЗаказыНаВыдачуСИЗ
		ПО (АктуальныеЗаказыНаВыдачуСИЗ.ФизическоеЛицо = ВыдачиСИЗ.ФизическоеЛицо)
		И (АктуальныеЗаказыНаВыдачуСИЗ.РабочееМесто = ВыдачиСИЗ.РабочееМесто)
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.РабочиеМестаСотрудниковИнтервальный КАК РабочиеМестаСотрудников
		ПО (РабочиеМестаСотрудников.ДатаНачала &lt;= КОНЕЦПЕРИОДА(&amp;ТекущаяДата, ДЕНЬ))
		И (РабочиеМестаСотрудников.ДатаОкончания >= КОНЕЦПЕРИОДА(&amp;ТекущаяДата, ДЕНЬ))
		И (РабочиеМестаСотрудников.ФизическоеЛицо = ВыдачиСИЗ.ФизическоеЛицо)
		И (РабочиеМестаСотрудников.РабочееМесто = ВыдачиСИЗ.РабочееМесто)</queryText>
      <mainTable>InformationRegister.ВыдачиСИЗ</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
