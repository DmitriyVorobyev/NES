  <attributes>
    <name>СоответствиеПеречнейВредныхФакторов</name>
    <title>
      <key>ru</key>
      <value>Соответствие перечней вредных факторов</value>
    </title>
    <id>11</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СоответствиеПеречнейВредныхФакторов.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ВредныеФакторыСправочник.Код КАК Код,
	ВредныеФакторыСправочник.Наименование КАК Наименование,
	ВредныеФакторыСправочник.Ссылка КАК Ссылка,
	ВредныеФакторыСправочник.СоответствиеПодтверждено КАК СоответствиеПодтверждено,
	ВЫБОР
		КОГДА ИСТИНА В
			(ВЫБРАТЬ ПЕРВЫЕ 1
				ИСТИНА
			ИЗ
				РегистрСведений.ВредныеФакторыРабочегоМеста КАК ВредныеФакторыРабочегоМеста
			ГДЕ
				ВредныеФакторыРабочегоМеста.ВредныйФактор = ВредныеФакторыСправочник.Ссылка)
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ЕстьВРабочихМестах
ИЗ
	Справочник.ВредныеОпасныеПроизводственныеФакторы КАК ВредныеФакторыСправочник
ГДЕ
	НЕ ВредныеФакторыСправочник.ЭтоГруппа
	И ВредныеФакторыСправочник.ВидОсмотра = &amp;ВидОсмотра

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВидыРаботСправочник.Код,
	ВидыРаботСправочник.Наименование,
	ВидыРаботСправочник.Ссылка,
	ВидыРаботСправочник.СоответствиеПодтверждено,
	ВЫБОР
		КОГДА ИСТИНА В
			(ВЫБРАТЬ ПЕРВЫЕ 1
				ИСТИНА
			ИЗ
				РегистрСведений.ВидыРаботМедицинскихОсмотровРабочегоМеста КАК ВидыРаботМедицинскихОсмотровРабочегоМеста
			ГДЕ
				ВидыРаботМедицинскихОсмотровРабочегоМеста.ВидРабот = ВидыРаботСправочник.Ссылка)
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ
ИЗ
	Справочник.ВидыРаботМедицинскихОсмотров КАК ВидыРаботСправочник
ГДЕ
	ВидыРаботСправочник.ВидОсмотра = &amp;ВидОсмотра

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ВидыДеятельностиСправочник.Код,
	ВидыДеятельностиСправочник.Наименование,
	ВидыДеятельностиСправочник.Ссылка,
	ВидыДеятельностиСправочник.СоответствиеПодтверждено,
	ВЫБОР
		КОГДА ИСТИНА В
			(ВЫБРАТЬ ПЕРВЫЕ 1
				ИСТИНА
			ИЗ
				РегистрСведений.ВредныеФакторыИВидыРаботРабочегоМеста КАК ВредныеФакторыИВидыРаботРабочегоМеста
			ГДЕ
				ВредныеФакторыИВидыРаботРабочегоМеста.ВредныйФактор = ВидыДеятельностиСправочник.Ссылка)
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ
ИЗ
	Справочник.ВредныеОпасныеПроизводственныеФакторыИВыполняемыеРаботы КАК ВидыДеятельностиСправочник
ГДЕ
	НЕ ВидыДеятельностиСправочник.ЭтоГруппа
	И ВидыДеятельностиСправочник.ВАрхиве
	И ВидыДеятельностиСправочник.ВидОсмотра = &amp;ВидОсмотра</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <keyField>Ссылка</keyField>
    </extInfo>
  </attributes>
