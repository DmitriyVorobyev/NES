    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>КлючевыеДолжности.КартинкаВида</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>КлючевыеДолжности.ПозицияШтатногоРасписания</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>КлючевыеДолжности.ЭтоКлючеваяДолжность</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	КадровыйРезерв.Ссылка КАК ПозицияКадровогоРезерва,
	КадровыйРезерв.ПозицияШтатногоРасписания КАК ПозицияШтатногоРасписания,
	КадровыйРезерв.ПозицияШтатногоРасписания.Должность КАК Должность,
	NULL КАК Подразделение
ПОМЕСТИТЬ ВТПозицииКадровогоРезерва
ИЗ
	Справочник.КадровыйРезерв КАК КадровыйРезерв
ГДЕ
	КадровыйРезерв.ВАрхиве = ЛОЖЬ
	И КадровыйРезерв.ПометкаУдаления = ЛОЖЬ
	И КадровыйРезерв.ПозицияШтатногоРасписания &lt;> ЗНАЧЕНИЕ(Справочник.ШтатноеРасписание.ПустаяСсылка)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	КадровыйРезервДолжности.Ссылка,
	NULL,
	КадровыйРезервДолжности.Должность,
	КадровыйРезервПодразделения.Подразделение
ИЗ
	Справочник.КадровыйРезерв.Должности КАК КадровыйРезервДолжности
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КадровыйРезерв.Подразделения КАК КадровыйРезервПодразделения
		ПО КадровыйРезервДолжности.Ссылка = КадровыйРезервПодразделения.Ссылка
			И КадровыйРезервДолжности.Должность = КадровыйРезервПодразделения.Должность
ГДЕ
	КадровыйРезервДолжности.Ссылка.ПометкаУдаления = ЛОЖЬ
	И КадровыйРезервДолжности.Ссылка.ВАрхиве = ЛОЖЬ

ИНДЕКСИРОВАТЬ ПО
	Должность,
	Подразделение
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	КадровыйРезерв.ПозицияРезерва КАК ПозицияРезерва,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КадровыйРезерв.УчастникКадровогоРезерва) КАК КоличествоРезервистов
ПОМЕСТИТЬ ВТАктуальныйРезерв
ИЗ
	РегистрСведений.КадровыйРезерв КАК КадровыйРезерв
ГДЕ
	(КадровыйРезерв.ДатаИсключения > &amp;ДатаИсключения
			ИЛИ КадровыйРезерв.ДатаИсключения = ДАТАВРЕМЯ(1, 1, 1))
	И КадровыйРезерв.Статус = ЗНАЧЕНИЕ(Перечисление.СостоянияСогласования.Согласовано)

СГРУППИРОВАТЬ ПО
	КадровыйРезерв.ПозицияРезерва

ИНДЕКСИРОВАТЬ ПО
	ПозицияРезерва
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ШтатноеРасписание.Ссылка КАК Ссылка,
	ШтатноеРасписание.Должность КАК Должность,
	МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.Подразделение КАК Подразделение
ПОМЕСТИТЬ ВТШтатноеРасписание
ИЗ
	Справочник.ШтатноеРасписание КАК ШтатноеРасписание
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МестоПозицииШтатногоРасписанияВСтруктуреПредприятия КАК МестоПозицииШтатногоРасписанияВСтруктуреПредприятия
		ПО ШтатноеРасписание.Ссылка = МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.Позиция
ГДЕ
	ШтатноеРасписание.Утверждена = ИСТИНА
	И ШтатноеРасписание.ГруппаПозицийПодразделения = ЛОЖЬ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	КлючевыеДолжностиКадровогоРезерва.Должность КАК КлючеваяДолжность,
	ВТШтатноеРасписание.Ссылка КАК ПозицияШтатногоРасписания,
	ВТШтатноеРасписание.Подразделение КАК Подразделение
ПОМЕСТИТЬ ВТПозицииШРКлючевыхДолжностей
ИЗ
	РегистрСведений.КлючевыеДолжностиКадровогоРезерва КАК КлючевыеДолжностиКадровогоРезерва
		ЛЕВОЕ СОЕДИНЕНИЕ ВТШтатноеРасписание КАК ВТШтатноеРасписание
		ПО КлючевыеДолжностиКадровогоРезерва.Должность = ВТШтатноеРасписание.Должность
			И (ВЫБОР
				КОГДА КлючевыеДолжностиКадровогоРезерва.Подразделение = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
					ТОГДА ИСТИНА
				ИНАЧЕ КлючевыеДолжностиКадровогоРезерва.Подразделение = ВТШтатноеРасписание.Подразделение
			КОНЕЦ)

ИНДЕКСИРОВАТЬ ПО
	КлючеваяДолжность,
	Подразделение
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТПозицииШРКлючевыхДолжностей.КлючеваяДолжность КАК КлючеваяДолжность,
	ВТПозицииШРКлючевыхДолжностей.ПозицияШтатногоРасписания КАК ПозицияШтатногоРасписания,
	ВТПозицииКадровогоРезерва.ПозицияКадровогоРезерва КАК ПозицияКадровогоРезерва
ПОМЕСТИТЬ ВТПозицииРезерваКлючевыхДолжностей
ИЗ
	ВТПозицииШРКлючевыхДолжностей КАК ВТПозицииШРКлючевыхДолжностей
		ЛЕВОЕ СОЕДИНЕНИЕ ВТПозицииКадровогоРезерва КАК ВТПозицииКадровогоРезерва
		ПО (ВЫБОР
				КОГДА ВТПозицииШРКлючевыхДолжностей.ПозицияШтатногоРасписания ЕСТЬ NULL
					ТОГДА ВТПозицииШРКлючевыхДолжностей.КлючеваяДолжность = ВТПозицииКадровогоРезерва.Должность
				ИНАЧЕ ВЫБОР
						КОГДА ВТПозицииКадровогоРезерва.ПозицияШтатногоРасписания ЕСТЬ NULL
							ТОГДА ВТПозицииШРКлючевыхДолжностей.КлючеваяДолжность = ВТПозицииКадровогоРезерва.Должность
									И ВЫБОР
										КОГДА ВТПозицииКадровогоРезерва.Подразделение ЕСТЬ NULL
											ТОГДА ИСТИНА
										ИНАЧЕ ВТПозицииШРКлючевыхДолжностей.Подразделение = ВТПозицииКадровогоРезерва.Подразделение
									КОНЕЦ
						ИНАЧЕ ВТПозицииШРКлючевыхДолжностей.ПозицияШтатногоРасписания = ВТПозицииКадровогоРезерва.ПозицияШтатногоРасписания
					КОНЕЦ
			КОНЕЦ)

ИНДЕКСИРОВАТЬ ПО
	ПозицияШтатногоРасписания
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	ВТПозицииКадровогоРезерва.ПозицияКадровогоРезерва КАК ПозицияКР,
	ВТШтатноеРасписание.Ссылка КАК ПозицияШР
ПОМЕСТИТЬ ВТПозицииШРПоРезерву
ИЗ
	ВТПозицииКадровогоРезерва КАК ВТПозицииКадровогоРезерва
		ЛЕВОЕ СОЕДИНЕНИЕ ВТШтатноеРасписание КАК ВТШтатноеРасписание
		ПО (ВЫБОР
				КОГДА ВТПозицииКадровогоРезерва.ПозицияШтатногоРасписания ЕСТЬ NULL
					ТОГДА ВТПозицииКадровогоРезерва.Должность = ВТШтатноеРасписание.Должность
							И ВЫБОР
								КОГДА ВТПозицииКадровогоРезерва.Подразделение ЕСТЬ NULL
									ТОГДА ИСТИНА
								ИНАЧЕ ВТПозицииКадровогоРезерва.Подразделение = ВТШтатноеРасписание.Подразделение
							КОНЕЦ
				ИНАЧЕ ВТПозицииКадровогоРезерва.ПозицияШтатногоРасписания = ВТШтатноеРасписание.Ссылка
			КОНЕЦ)
ГДЕ
	НЕ ВТШтатноеРасписание.Ссылка ЕСТЬ NULL

ИНДЕКСИРОВАТЬ ПО
	ПозицияШР
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	ВТПозицииРезерваКлючевыхДолжностей.КлючеваяДолжность КАК КлючеваяДолжность,
	ЕСТЬNULL(ВТПозицииРезерваКлючевыхДолжностей.ПозицияШтатногоРасписания, ВТПозицииШРПоРезерву.ПозицияШР) КАК ПозицияШтатногоРасписания,
	ЕСТЬNULL(ВТПозицииРезерваКлючевыхДолжностей.ПозицияКадровогоРезерва, ВТПозицииШРПоРезерву.ПозицияКР) КАК ПозицияКадровогоРезерва
ПОМЕСТИТЬ ВТВесьРезерв
ИЗ
	ВТПозицииРезерваКлючевыхДолжностей КАК ВТПозицииРезерваКлючевыхДолжностей
		ПОЛНОЕ СОЕДИНЕНИЕ ВТПозицииШРПоРезерву КАК ВТПозицииШРПоРезерву
		ПО ВТПозицииРезерваКлючевыхДолжностей.ПозицияШтатногоРасписания = ВТПозицииШРПоРезерву.ПозицияШР

ИНДЕКСИРОВАТЬ ПО
	ПозицияКадровогоРезерва
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТВесьРезерв.КлючеваяДолжность КАК КлючеваяДолжность,
	ВТВесьРезерв.ПозицияШтатногоРасписания КАК ПозицияШтатногоРасписания,
	СУММА(ВТАктуальныйРезерв.КоличествоРезервистов) КАК КоличествоРезервистов,
	МАКСИМУМ(ВЫБОР
			КОГДА ВТВесьРезерв.ПозицияКадровогоРезерва ЕСТЬ NULL
				ТОГДА ЛОЖЬ
			ИНАЧЕ ИСТИНА
		КОНЕЦ) КАК ЕстьПозицииРезерва
ПОМЕСТИТЬ ВТКадровыйРезерв
ИЗ
	ВТВесьРезерв КАК ВТВесьРезерв
		ЛЕВОЕ СОЕДИНЕНИЕ ВТАктуальныйРезерв КАК ВТАктуальныйРезерв
		ПО ВТВесьРезерв.ПозицияКадровогоРезерва = ВТАктуальныйРезерв.ПозицияРезерва

СГРУППИРОВАТЬ ПО
	ВТВесьРезерв.КлючеваяДолжность,
	ВТВесьРезерв.ПозицияШтатногоРасписания
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЕСТЬNULL(ВТКадровыйРезерв.КлючеваяДолжность, ВТКадровыйРезерв.ПозицияШтатногоРасписания.Должность) КАК Должность,
	ВЫБОР
		КОГДА ВТКадровыйРезерв.КлючеваяДолжность ЕСТЬ NULL
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК ЭтоКлючеваяДолжность,
	ВТКадровыйРезерв.ПозицияШтатногоРасписания КАК ПозицияШтатногоРасписания,
	ВТКадровыйРезерв.ПозицияШтатногоРасписания.Подразделение КАК Подразделение,
	ВТКадровыйРезерв.ПозицияШтатногоРасписания.Владелец КАК Организация,
	ВЫБОР
		КОГДА НЕ ВТКадровыйРезерв.ЕстьПозицииРезерва
			ТОГДА 3
		ИНАЧЕ ВЫБОР
				КОГДА ВТКадровыйРезерв.КоличествоРезервистов > 0
					ТОГДА 2
				ИНАЧЕ 1
			КОНЕЦ
	КОНЕЦ КАК КартинкаВида,
	&quot;&quot; КАК ПредставлениеДолжности,
	&quot;Грейд&quot; КАК Грейд
ИЗ
	ВТКадровыйРезерв КАК ВТКадровыйРезерв</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>Должность</dataPath>
        <field>Должность</field>
      </fields>
      <fields xsi:type="schema:DataCompositionSchemaDataSetField">
        <dataPath>КартинкаВида</dataPath>
        <field>КартинкаВида</field>
        <title>
          <localValue>
            <content>
              <key>ru</key>
